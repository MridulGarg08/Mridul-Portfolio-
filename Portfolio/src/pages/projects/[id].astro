---
import Layout from '../../layouts/Layout.astro';
import { projectsData, type Project } from '../../data/projects';
import { personalData } from '../../data/personal';

export function getStaticPaths() {
  return projectsData.map((project, index) => {
    const nextProject = projectsData[(index + 1) % projectsData.length];
    return {
      params: { id: project.id },
      props: { project, nextProject }
    };
  });
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
---

<Layout title={`${project.title} — ${personalData.name}`}>
  <article class="project-detail-page">
    <div class="container">
      <!-- Back to All Projects Link -->
      <div class="back-link-wrapper reveal-fade">
        <a href="/#projects" class="link-underline back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Back to All Projects</span>
        </a>
      </div>

      <!-- Project Hero Header -->
      <header class="detail-header">
        <div class="mask-line section-title-line">
          <h1 class="line-content detail-title" transition:name={`project-title-${project.id}`}>{project.title}</h1>
        </div>
        <span class="section-title-underline"></span>

        <p class="detail-description reveal-fade">{project.description}</p>

        <div class="tags-row reveal-fade" aria-label="Technologies used">
          {project.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>

        <div class="action-buttons reveal-fade">
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-magnetic">
            <span>Visit Live Application</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-magnetic">
            <span>View Source Code</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>
      </header>

      <!-- Featured Image Banner with Shared View Transition Element -->
      {project.image ? (
        <div class="detail-banner-wrapper reveal-fade">
          <img 
            src={project.image} 
            alt={project.imageAlt || project.title} 
            class="detail-banner-img"
            transition:name={`project-image-${project.id}`}
            width="1200"
            height="675"
          />
        </div>
      ) : (
        <div class="detail-banner-fallback reveal-fade">
          <span class="fallback-icon">&lt;/&gt;</span>
          <span class="fallback-text">{project.title} Architecture Overview</span>
        </div>
      )}

      <!-- Detailed Content Section -->
      <section class="detail-body-grid">
        <div class="main-content-col reveal-fade">
          <h3>Overview & Objectives</h3>
          <p>
            {project.title} was built to address technical bottlenecks in high-throughput workflows. The system leverages {project.tags.join(', ')} to provide predictable response times, clear operational insights, and modular developer extensibility.
          </p>

          <h3>Key Architectural Highlights</h3>
          <ul class="highlights-bullets">
            <li>Designed for high efficiency and low runtime overhead.</li>
            <li>Fully responsive UI adhering strictly to WCAG AA accessibility standards.</li>
            <li>Optimized data pipelines with caching layers for fast load speeds.</li>
          </ul>
        </div>

        <aside class="sidebar-col reveal-fade">
          <div class="sidebar-box">
            <h4>Project Specs</h4>
            <div class="spec-item">
              <span class="spec-label">Role</span>
              <span class="spec-value">Lead Architect</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Type</span>
              <span class="spec-value">{project.featured ? "Featured Project" : "System Tool"}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Stack</span>
              <span class="spec-value">{project.tags.slice(0, 3).join(', ')}</span>
            </div>
          </div>
        </aside>
      </section>

      <!-- Next Project Transition Footer Link -->
      <nav class="next-project-nav reveal-fade" aria-label="Next project navigation">
        <a href={`/projects/${nextProject.id}`} class="next-project-card">
          <div class="next-label">Next Project &rarr;</div>
          <h3 class="next-title">{nextProject.title}</h3>
          <p class="next-description">{nextProject.description}</p>
        </a>
      </nav>
    </div>
  </article>
</Layout>

<style>
  .project-detail-page {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .back-link-wrapper {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .detail-header {
    margin-bottom: var(--space-2xl);
  }

  .detail-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-bottom: 0.25rem;
  }

  .detail-description {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    max-width: 65ch;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .detail-banner-wrapper {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-bottom: var(--space-3xl);
    box-shadow: var(--card-shadow-hover);
    background-color: var(--bg-surface-subtle);
  }

  .detail-banner-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .detail-banner-fallback {
    height: 320px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: var(--space-3xl);
  }

  .fallback-icon {
    font-family: var(--font-mono);
    font-size: 3rem;
    color: var(--color-accent);
  }

  .fallback-text {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .detail-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: var(--space-3xl);
  }

  @media (min-width: 768px) {
    .detail-body-grid {
      grid-template-columns: 1.8fr 1fr;
      gap: 3.5rem;
    }
  }

  .main-content-col h3 {
    font-size: 1.4rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .main-content-col p {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .highlights-bullets {
    margin-left: 1.25rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .highlights-bullets li {
    margin-bottom: 0.5rem;
  }

  .sidebar-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .sidebar-box h4 {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
  }

  .spec-label {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .spec-value {
    font-weight: 600;
    color: var(--text-main);
  }

  /* Next Project Card Navigation */
  .next-project-nav {
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-2xl);
  }

  .next-project-card {
    display: block;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: var(--transition-subtle);
    text-decoration: none;
  }

  .next-project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .next-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .next-project-card:hover .next-title {
    color: var(--color-accent);
  }

  .next-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }
</style>
