---
import { personalData } from '../data/personal';
---

<section id="hero" class="hero-section section">
  <div class="container hero-container">
    <div class="availability-wrapper">
      <span class="badge-availability">
        <span class="pulse-dot" aria-hidden="true"></span>
        {personalData.availability}
      </span>
    </div>

    <h1 class="hero-name">{personalData.name}</h1>
    <div class="hero-role">{personalData.role} &mdash; {personalData.location}</div>

    <p class="hero-intro">
      {personalData.oneLiner}
    </p>

    <div class="hero-actions">
      <a href={personalData.links.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-magnetic">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <a href={personalData.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-magnetic">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a href={`mailto:${personalData.links.email}`} class="btn btn-primary btn-magnetic">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Email Me</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-2xl);
  }

  .availability-wrapper {
    margin-bottom: var(--space-md);
  }

  .hero-name {
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--text-main) 70%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    font-weight: 500;
  }

  .hero-intro {
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    line-height: 1.55;
    color: var(--text-main);
    margin-bottom: var(--space-xl);
    max-width: 62ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
</style>
