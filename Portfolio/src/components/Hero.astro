---
import { personalData } from '../data/personal';

const initials = personalData.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<section id="hero" class="hero-section section">
  <div class="container hero-container">
    <div class="hero-text">
      <span class="badge-availability">
        <span class="pulse-dot" aria-hidden="true"></span>
        {personalData.availability}
      </span>

      <p class="hero-eyebrow">Hi, I'm {personalData.name}</p>
      <h1 class="hero-name">I'm a {personalData.role}</h1>
      <div class="hero-role">{personalData.location}</div>

      <p class="hero-intro">{personalData.oneLiner}</p>

      <div class="hero-actions">
        <a href="#projects" class="btn btn-outline btn-magnetic">
          <span>Go To Portfolio</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href={`mailto:${personalData.links.email}`} class="btn btn-primary btn-magnetic">
          <span>Email Me</span>
        </a>
        <a href={personalData.links.github} target="_blank" rel="noopener noreferrer" class="hero-social" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href={personalData.links.linkedin} target="_blank" rel="noopener noreferrer" class="hero-social" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-photo-ring">
        <span class="hero-initials">{initials}</span>
        <img src="/profile.jpg" alt={`Portrait of ${personalData.name}`} class="hero-photo" width="360" height="360" loading="eager" onerror="this.style.display='none'" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    background:
      radial-gradient(circle at 78% 45%, rgba(20, 184, 166, 0.28), transparent 42%),
      radial-gradient(circle at 12% 0%, rgba(79, 70, 229, 0.28), transparent 40%),
      linear-gradient(135deg, #0b1120 0%, #141a3a 60%, #0d1428 100%);
    border-bottom: none;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .hero-container { grid-template-columns: 1.2fr 0.8fr; }
  }

  .hero-text .badge-availability { margin-bottom: 1.25rem; }

  .hero-eyebrow {
    font-family: var(--font-mono);
    color: #2dd4bf;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .hero-name {
    color: #f8fafc;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }

  .hero-intro {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
  }

  .hero-section :global(.btn-outline) {
    background: transparent;
    color: #f8fafc;
    border: 1px solid rgba(248, 250, 252, 0.45);
  }
  .hero-section :global(.btn-outline:hover) {
    border-color: #2dd4bf;
    color: #2dd4bf;
    transform: translateY(-2px);
  }

  .hero-social {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #cbd5e1;
    border: 1px solid rgba(148, 163, 184, 0.35);
    transition: transform 0.25s var(--ease-out-expo), color 0.2s ease, border-color 0.2s ease;
  }
  .hero-social:hover {
    color: #2dd4bf;
    border-color: #2dd4bf;
    transform: translateY(-3px);
  }

  /* --- Photo with glowing ring --- */
  .hero-photo-wrap {
    display: flex;
    justify-content: center;
  }

  .hero-photo-ring {
    position: relative;
    width: min(320px, 72vw);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: conic-gradient(from 210deg, #14b8a6, #4f46e5, #14b8a6);
    box-shadow: 0 0 80px -10px rgba(20, 184, 166, 0.55), 0 30px 60px -20px rgba(0, 0, 0, 0.6);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero-initials {
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 5rem;
    font-weight: 800;
    color: #2dd4bf;
    background: radial-gradient(circle at 30% 20%, #1b2940, #0b1120);
  }

  .hero-photo {
    position: absolute;
    inset: 6px;
    width: calc(100% - 12px);
    height: calc(100% - 12px);
    border-radius: 50%;
    object-fit: cover;
  }
</style>