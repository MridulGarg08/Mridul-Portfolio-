---
import { projectsData } from '../data/projects';

const featuredProjects = projectsData.filter(p => p.featured);
const otherProjects = projectsData.filter(p => !p.featured);
---

<section id="projects" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Selected Work</h2>
      <span class="section-title-underline"></span>
      <p>A selection of applications, systems, and open-source tools I've engineered.</p>
    </div>

    <!-- Featured Projects (Higher Visual Hierarchy) -->
    <div class="featured-projects-list">
      {featuredProjects.map((project) => (
        <article class="featured-card">
          {project.image && (
            <a href={`/projects/${project.id}`} class="featured-image-link" data-cursor="view" aria-label={`View details for ${project.title}`}>
              <div class="featured-image-wrapper">
                <img 
                  src={project.image} 
                  alt={project.imageAlt || project.title} 
                  class="featured-img"
                  transition:name={`project-image-${project.id}`}
                  loading="eager"
                  decoding="async"
                  onerror="this.style.visibility='hidden'"
                  width="800"
                  height="450"
                />
              </div>
            </a>
          )}
          <div class="featured-content">
            <h3 class="featured-title">
              <a href={`/projects/${project.id}`} transition:name={`project-title-${project.id}`} class="title-link">
                {project.title}
              </a>
            </h3>
            <p class="featured-description">{project.description}</p>

            <div class="tags-row" aria-label="Technologies used">
              {project.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <div class="project-links">
              <a href={`/projects/${project.id}`} class="link-underline project-link">
                <span>View Details</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="link-underline project-link">
                <span>Live Demo</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon" aria-hidden="true">
                  <path d="M7 17L17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="link-underline project-link">
                <span>Source Code</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon" aria-hidden="true">
                  <path d="M7 17L17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Secondary Projects Grid (Lower Visual Hierarchy) -->
    <div class="secondary-projects-header">
      <h3 class="secondary-heading">Other Projects & Utilities</h3>
    </div>

    <div class="secondary-projects-grid">
      {otherProjects.map((project) => (
        <article class="compact-card">
          <div class="compact-header">
            <h4 class="compact-title">
              <a href={`/projects/${project.id}`} class="compact-title-link">
                {project.title}
              </a>
            </h4>
            <div class="compact-links">
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} source code`} class="icon-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
              </a>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} live link`} class="icon-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>

          <p class="compact-description">{project.description}</p>

          <div class="tags-row">
            {project.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* --- Featured Projects Layout --- */
  .featured-projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 1.75rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: var(--transition-subtle);
    position: relative;
  }

  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 1.15fr 1fr;
      gap: 2rem;
      align-items: center;
      padding: 2.25rem;
    }
  }

  .featured-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
  }

  .featured-image-link {
    display: block;
    cursor: pointer;
  }

  .featured-image-wrapper {
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface-subtle);
  }

  .featured-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-card:hover .featured-img {
    transform: scale(1.04);
  }

  .featured-title {
    font-size: 1.45rem;
    margin-bottom: 0.75rem;
  }

  .title-link {
    color: inherit;
    transition: color 0.2s ease;
  }

  .featured-card:hover .title-link {
    color: var(--color-accent);
  }

  .featured-description {
    font-size: 0.975rem;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .project-link {
    font-size: 0.875rem;
    font-family: var(--font-mono);
  }

  .arrow-icon {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .project-link:hover .arrow-icon {
    transform: translate(4px, -4px);
  }

  /* --- Secondary Projects Grid --- */
  .secondary-projects-header {
    margin-bottom: 1.25rem;
  }

  .secondary-heading {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .secondary-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .compact-card {
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition-subtle);
  }

  .compact-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    background-color: var(--bg-surface);
    box-shadow: var(--card-shadow-hover);
  }

  .compact-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .compact-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .compact-title-link {
    color: inherit;
    transition: color 0.2s ease;
  }

  .compact-card:hover .compact-title-link {
    color: var(--color-accent);
  }

  .compact-links {
    display: flex;
    gap: 0.5rem;
  }

  .icon-link {
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .icon-link:hover {
    color: var(--color-accent);
    transform: scale(1.15);
  }

  .compact-description {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
</style>